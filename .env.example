# ─────────────────────────────────────────────────────────────────────────────
# PLeC — environment variable reference
# Copy this file to .env (which is git-ignored) for local development.
# In production (Heroku, Replit Deploy, etc.) set these as platform secrets.
# ─────────────────────────────────────────────────────────────────────────────

# ── Required ─────────────────────────────────────────────────────────────────

# Django cryptographic signing key.
# Generate a strong value with: python -c "import secrets; print(secrets.token_urlsafe(64))"
# The app refuses to start if this is missing or shorter than 50 characters.
DJANGO_SECRET_KEY=replace-me-with-a-long-random-string

# ── Database ─────────────────────────────────────────────────────────────────

# PostgreSQL connection URL — required in production.
# On Heroku: set automatically when you add the Heroku Postgres add-on.
# On Replit: set automatically by the built-in PostgreSQL integration.
# Local dev: leave unset to fall back to SQLite (plec.db, git-ignored).
# DATABASE_URL=postgres://user:password@host:5432/dbname

# ── Django settings ───────────────────────────────────────────────────────────

# Set to True only for local development. Never True in production.
# Defaults to False if unset — safe for production.
DJANGO_DEBUG=True

# Comma-separated list of hostnames Django will serve.
# Development: localhost and Replit preview domains.
# Production: your exact domain only (no wildcards).
ALLOWED_HOSTS=localhost,127.0.0.1,.replit.dev,.replit.app

# Comma-separated HTTPS origins allowed to POST forms (Django 4.0+).
# Required in production — must include the scheme (https://).
# CSRF_TRUSTED_ORIGINS=https://your-app.replit.app

# ── Email (password-reset and admin alerts) ───────────────────────────────────

# Defaults to console backend (prints emails to the server log).
# Set EMAIL_BACKEND to use real SMTP:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=noreply@example.com
# EMAIL_HOST_PASSWORD=replace-me
# EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL=PLeC <noreply@example.com>

# ── Admin notifications ───────────────────────────────────────────────────────

# Comma-separated "Name:email" pairs notified on errors and lockout events.
# DJANGO_ADMINS=John Parman:j.parman@dudleycol.ac.uk
